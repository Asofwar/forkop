#!/bin/sh /etc/rc.common
START=19
STOP=99
USE_PROCD=1
EXTRA_COMMANDS="offline online restore release"
EXTRA_HELP="        release Remove the persistent VPN guard explicitly"
guard() { ucode -L /usr/lib/forkop /usr/lib/forkop/nft/fail_closed.uc "$@"; }
start_service() {
    [ -f /etc/forkop/vpn-guard/policy.json ] || return 0
    guard load || return 1
    guard register-firewall || return 1
    for conf in /tmp/forkop-vpn-guard/dns-*.conf; do
        [ -f "$conf" ] || continue
        procd_open_instance "$(basename "$conf" .conf)"
        procd_set_param command /usr/sbin/dnsmasq --keep-in-foreground --conf-file="$conf" --pid-file=
        procd_set_param file "$conf"
        procd_set_param respawn
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    done
    procd_open_instance watch
    procd_set_param command /usr/bin/ucode -L /usr/lib/forkop /usr/lib/forkop/nft/fail_closed.uc watch
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
offline() { guard offline; }
online() { guard online; }
restore() { guard restore; }
stop_service() {
    guard checkpoint || return 1
    # Preserve kernel protection even when the DNS responders stop.
    guard offline-auto
}
release() {
    [ "$(uci -q get forkop.settings.vpn_fail_closed)" != 1 ] || return 1
    /etc/init.d/forkop-guard stop
    guard remove || return 1
    /etc/init.d/forkop-guard disable
}
