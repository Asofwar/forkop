#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

# The kill-switch's own nftables policy is loaded by fw4 (the package's
# ruleset-post loader). This service only keeps DNS usable for unprotected
# names when sing-box dies while dnsmasq still forwards to it: a standby
# dnsmasq answers protected names locally and everything else through the
# ordinary upstream, and a watcher redirects client DNS to it until sing-box
# answers again.

START=20
STOP=90
USE_PROCD=1

FORKOP_LIB="/usr/lib/forkop"
KILLSWITCH_UC="$FORKOP_LIB/killswitch/runtime.uc"
STANDBY_CONF="/tmp/forkop-killswitch/standby.conf"

killswitch() {
    ucode -L "$FORKOP_LIB" "$KILLSWITCH_UC" "$@"
}

boot() {
    # A sysupgrade keeps the saved block list, never the servers file
    # dnsmasq reads (lib/upgrade/keep.d/forkop-killswitch): an image without
    # Forkop must not keep blocking. With Forkop, attach it again here: an
    # OpenWrt image enables every rc.common script it ships
    # (include/rootfs.mk, prepare_rootfs), so this runs whether or not a
    # sync had enabled the service before the sysupgrade.
    if [ -r "$KILLSWITCH_UC" ] && killswitch armed >/dev/null 2>&1; then
        ucode -L "$FORKOP_LIB" "$FORKOP_LIB/dns/apply.uc" killswitch-refresh >/dev/null 2>&1
    fi
    start "$@"
}

start_service() {
    [ -r "$KILLSWITCH_UC" ] || return 0
    killswitch armed >/dev/null 2>&1 || return 0
    killswitch standby-config "$STANDBY_CONF" >/dev/null 2>&1 || return 1

    procd_open_instance standby
    procd_set_param command /usr/sbin/dnsmasq --keep-in-foreground \
        --conf-file="$STANDBY_CONF" --pid-file=
    procd_set_param file "$STANDBY_CONF"
    procd_set_param respawn 3600 5 0
    procd_close_instance

    procd_open_instance watch
    procd_set_param command /usr/bin/ucode -L "$FORKOP_LIB" "$KILLSWITCH_UC" watch
    procd_set_param respawn 3600 5 0
    procd_close_instance
}

stop_service() {
    # Never leave clients pointed at a standby that is going away.
    [ -r "$KILLSWITCH_UC" ] && killswitch dns-redirect off >/dev/null 2>&1
    return 0
}
